# Copy this file to .env.local for local development.
# Use a unique random secret in every deployed environment.
JWT_SECRET=replace-with-a-long-random-secret

# Local WebAuthn configuration.
RP_ID=localhost
RP_NAME=Todo App
RP_ORIGIN=http://localhost:3000

# Production example:
# JWT_SECRET=<generate-a-32+-character-random-secret>
# RP_ID=your-app.up.railway.app
# RP_NAME=Todo App
# RP_ORIGIN=https://your-app.up.railway.app
